{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rabbit Chat Studio",
  "version": "3.1.1",
  "identifier": "com.leonard.aichat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rabbit Chat Studio",
        "width": 1000,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "XLBBB",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}